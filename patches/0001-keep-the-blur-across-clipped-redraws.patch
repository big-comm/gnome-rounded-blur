+/* A redraw clipped to part of the surface leaves the rest of the framebuffer
+ * holding the previous frame, with this surface and what is above it already
+ * drawn. Blurring that again shows the clipped part in a different shade for a
+ * frame, so such a redraw keeps the blur of the last whole one.
+ */
+static gboolean
+redraw_covers_surface (GbBlurEffect        *self,
+                       ClutterPaintContext *paint_context)
+{
+  ClutterStageView *stage_view;
+  const MtkRegion *redraw_clip;
+  MtkRectangle view_layout;
+  MtkRectangle surface;
+  float x, y, width, height;
+
+  stage_view = clutter_paint_context_get_stage_view (paint_context);
+  redraw_clip = clutter_paint_context_get_redraw_clip (paint_context);
+  if (!stage_view || !redraw_clip)
+    return TRUE;
+
+  clutter_actor_get_transformed_position (self->actor, &x, &y);
+  clutter_actor_get_transformed_size (self->actor, &width, &height);
+  surface = (MtkRectangle) {
+    .x = floorf (x),
+    .y = floorf (y),
+    .width = ceilf (x + width) - floorf (x),
+    .height = ceilf (y + height) - floorf (y),
+  };
+
+  /* The clip never reaches the part of a surface outside the view. */
+  clutter_stage_view_get_layout (stage_view, &view_layout);
+  if (!mtk_rectangle_intersect (&surface, &view_layout, &surface))
+    return TRUE;
+
+  return mtk_region_contains_rectangle (redraw_clip, &surface) ==
+         MTK_REGION_OVERLAP_IN;
+}
+
+static gboolean
+blur_matches_surface (GbBlurEffect        *self,
+                      ClutterPaintContext *paint_context)
+{
+  ClutterActorBox source_actor_box;
+  float width, height;
+
+  update_actor_box (self, paint_context, &source_actor_box);
+  clutter_actor_box_get_size (&source_actor_box, &width, &height);
+
+  return self->tex_width == (unsigned int) width &&
+         self->tex_height == (unsigned int) height;
+}
