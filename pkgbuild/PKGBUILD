# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=gnome-rounded-blur
pkgdesc="Rounded-corner blur effect for GNOME Shell, used by Frosted Glass and Big Clipboard"
depends=('glib2' 'mutter>=51')
makedepends=('git' 'meson' 'gobject-introspection' 'gjs')
#optdepends=('')
#conflicts=('')
#provides=('')
#replaces=('')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    # Fixes not released upstream yet (see README.md)
    local patch
    for patch in patches/*.patch; do
        patch -p1 < "${patch}"
    done
}

build() {
    cd "${srcdir}/${pkgname}"
    # upstream/ holds the library source, patched in prepare() (see README.md)
    arch-meson upstream "${srcdir}/build"
    meson compile -C "${srcdir}/build"
}

check() {
    cd "${srcdir}/${pkgname}"
    # Resolve every symbol now (as GNOME Shell's extensions probe it) and
    # create a rounded background effect against the installed mutter.
    local typelib mutterLib clutterVersion
    typelib=$(echo /usr/lib/mutter-*/Clutter-*.typelib)
    mutterLib=${typelib%/*}
    clutterVersion=${typelib##*/Clutter-}
    clutterVersion=${clutterVersion%.typelib}
    GI_TYPELIB_PATH="${srcdir}/build/src:${mutterLib}" \
    LD_LIBRARY_PATH="${srcdir}/build/src:${mutterLib}" \
    LD_BIND_NOW=1 \
    gjs -c "imports.gi.versions.Clutter = '${clutterVersion}';
        const Blur = imports.gi.Blur;
        const effect = new Blur.BlurEffect({mode: Blur.BlurMode.BACKGROUND});
        effect.corner_radius = 24;
        if (effect.corner_radius !== 24)
            throw new Error('corner radius was not applied');
        // gjs -c exits with the last expression value; end on a statement.
        print('Rounded blur effect loads');"
}

package() {
    cd "${srcdir}/${pkgname}"

    meson install -C "${srcdir}/build" --destdir "${pkgdir}"

    # The upstream license covers the packaged library
    install -Dm644 upstream/LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
